{
  "name": "@antelopejs/dms-api-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dms.frontend.ts",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0"
  },
  "scripts": {
    "dev": "pnpm --dir ../playground frontend:dev",
    "build": "pnpm --dir ../playground exec ajs dms build",
    "typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.2.11",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^6.0.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
