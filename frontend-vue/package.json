{
  "name": "@antelopejs/dms-api-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dms.frontend.ts",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm --dir ../playground frontend:dev",
    "build": "pnpm --dir ../playground exec ajs dms build",
    "typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "json-schema-to-zod": "^2.6.0",
    "vue": "^3.5.18",
    "vuedraggable": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nuxt/ui": "4.10.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
