{
  "name": "@antelopejs/dms-api",
  "version": "0.5.1",
  "description": "API console for the AntelopeJS DMS: API health, request logs, per-route statistics, inferred contracts and a request tester.",
  "keywords": [
    "antelopejs",
    "api",
    "dms",
    "dms-module",
    "monitoring",
    "request-logs"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/api",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-api/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-api.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "skills"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project dev -w -p playground",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && pnpm --dir frontend-vue lint && antelopejs-check-interface-ranges",
    "typecheck": "tsc -p tests",
    "test": "vitest run && pnpm --dir frontend-vue test",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "release": "pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.11 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-dms": ">=0.9.0 <1.0.0",
    "node-cron": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": "1.17.1",
    "@antelopejs/tooling-configs": "^0.2.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.2.1 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
