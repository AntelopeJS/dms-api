{
  "name": "@antelopejs/dms-api",
  "version": "0.8.0",
  "description": "API console for the AntelopeJS DMS: API health, request logs, per-route statistics, inferred contracts and a request tester.",
  "keywords": [
    "antelopejs",
    "api",
    "dms",
    "dms-module",
    "monitoring",
    "request-logs"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/api",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-api/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-api.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "skills"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project dev -w -p playground",
    "e2e": "playwright test -c e2e",
    "e2e:build": "pnpm run build && pnpm --dir playground install --ignore-workspace --frozen-lockfile --prefer-offline --ignore-scripts && ln -sfn ../../playground/node_modules e2e/playground/node_modules && tsc -p e2e/playground/tsconfig.build.json",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && pnpm --dir frontend-vue lint",
    "typecheck": "tsc -p tests && tsc -p frontend-vue/tests --skipLibCheck",
    "test": "vitest run && pnpm --dir frontend-vue test",
    "test:journeys": "vitest run -c vitest.journeys.config.ts",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.5 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-database": ">=0.4.4 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0",
    "@antelopejs/interface-dms": ">=0.17.3 <0.18.0",
    "node-cron": "^4.2.1",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.5",
    "@antelopejs/dms": ">=0.25.2 <0.26.0",
    "@antelopejs/dms-frontend": ">=0.11.11 <0.12.0",
    "@antelopejs/interface-data-api": ">=0.8.2 <0.9.0",
    "@antelopejs/tooling-configs": "^0.10.15",
    "@playwright/test": "~1.65.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb": "~7.5.0",
    "mongodb-memory-server-core": "^11.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "semver": "^7.8.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.7.0 <0.8.0"
  },
  "packageManager": "pnpm@10.34.9",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
