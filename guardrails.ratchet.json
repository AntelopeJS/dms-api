{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 4,
    "anti-slop/no-known-value-widening": 4,
    "anti-slop/no-runtime-typeof": 2,
    "anti-slop/no-unknown-parameters": 8,
    "anti-slop/no-unknown-returns": 2,
    "anti-slop/require-safety-comment-for-type-assertion": 5,
    "typescript/no-unsafe-argument": 3,
    "typescript/no-unsafe-assignment": 13,
    "typescript/no-unsafe-return": 5,
    "typescript/use-unknown-in-catch-callback-variable": 2
  },
  "oversizeFiles": {}
}
