    {
      "id": "dms-api-route-500-casual",
      "area": "modules",
      "style": "casual",
      "prompt": "one route keeps failing in prod, where are the request logs with the body",
      "expect": {
        "skills": ["dms-api"],
        "acceptable": ["dms", "api-interface"]
      }
    },
    {
      "id": "dms-api-retention-slowness",
      "area": "modules",
      "style": "clean",
      "prompt": "Keep the request logs for 14 days and flag requests slower than 800 ms in the API console. What do I set?",
      "expect": {
        "skills": ["dms-api"],
        "acceptable": ["dms", "dms-project"],
        "mustMention": ["requestLogRetention", "requestSlownessThreshold"]
      }
    },
    {
      "id": "dms-api-not-controller",
