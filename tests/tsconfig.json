{
  // Type-checks the back-end tests against the sources without emitting:
  // the root config's rootDir/outDir only cover src/ and the published dist.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
